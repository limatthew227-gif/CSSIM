    "scrape:hltv-splits": "python3 scripts/scrape-hltv-player-splits.py",
    "scrape:hltv-splits:uc": "python3 scripts/scrape-hltv-player-splits-uc.py --write-ts"
  },
  "dependencies": {
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@laihoe/demoparser2": "^0.41.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "hltv": "^3.5.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.22.4"
  }
