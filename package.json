{
  "name": "major-draft-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "preview:map": "tsx scripts/preview-map.ts",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "generate:mirage-nav": "tsx scripts/generate-mirage-nav-mesh.ts",
    "generate:voxel-maps": "tsx scripts/generate-voxel-map-data.ts",
    "analyze:demo-spacing": "tsx scripts/analyze-demo-spacing.ts",
    "verify:hltv": "node scripts/verify-hltv-top20.mjs",
